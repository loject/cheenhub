    {
      "label": "CheenHub: bootstrap cargo-make",
      "type": "process",
      "command": "/usr/bin/zsh",
      "args": [
        "-i",
        "-c",
        "cargo install --locked --root \"$HOME/.local\" --version 0.37.24 cargo-make"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "clear": false,
        "close": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
